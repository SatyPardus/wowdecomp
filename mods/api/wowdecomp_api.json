{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wowdecomp Universal Modding Framework API",
  "version": "1.1.0",
  "engine": "wowdecomp",
  "modules": {
    "ModCore": {
      "description": "Master modding framework runtime controller",
      "parent": "",
      "methods": [
        {
          "name": "LogDebug",
          "description": "Logs a debug message to client console",
          "returnType": "void",
          "params": [
            {
              "name": "fmt",
              "type": "string",
              "description": "Format string"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Arguments"
            }
          ]
        },
        {
          "name": "LogInfo",
          "description": "Logs an info message to client console",
          "returnType": "void",
          "params": [
            {
              "name": "fmt",
              "type": "string",
              "description": "Format string"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Arguments"
            }
          ]
        },
        {
          "name": "LogWarn",
          "description": "Logs a warning message to client console",
          "returnType": "void",
          "params": [
            {
              "name": "fmt",
              "type": "string",
              "description": "Format string"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Arguments"
            }
          ]
        },
        {
          "name": "LogError",
          "description": "Logs an error message to client console",
          "returnType": "void",
          "params": [
            {
              "name": "fmt",
              "type": "string",
              "description": "Format string"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Arguments"
            }
          ]
        },
        {
          "name": "MountMod",
          "description": "Mounts and initializes an external mod package",
          "returnType": "boolean",
          "params": [
            {
              "name": "modDir",
              "type": "string",
              "description": "Path"
            },
            {
              "name": "manifest",
              "type": "table",
              "description": "Manifest"
            }
          ]
        },
        {
          "name": "RegisterHook",
          "description": "Registers a callback listener for an engine or gameplay hook",
          "returnType": "void",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "callback",
              "type": "fun(...): any?",
              "description": "Listener"
            },
            {
              "name": "priority?",
              "type": "integer",
              "description": "Priority (default 100)"
            },
            {
              "name": "doc?",
              "type": "string",
              "description": "Documentation"
            }
          ]
        },
        {
          "name": "UnregisterHook",
          "description": "Unregisters a callback from a hook",
          "returnType": "void",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "callback",
              "type": "fun(...)",
              "description": "Listener"
            }
          ]
        },
        {
          "name": "FireHook",
          "description": "Fires a hook across all listeners and returns early override if non-nil",
          "returnType": "any?",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Parameters"
            }
          ]
        },
        {
          "name": "On",
          "description": "Event emitter syntax alias for RegisterHook",
          "returnType": "void",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "callback",
              "type": "fun(...): any?",
              "description": "Listener"
            },
            {
              "name": "priority?",
              "type": "integer",
              "description": "Priority"
            },
            {
              "name": "doc?",
              "type": "string",
              "description": "Documentation"
            }
          ]
        },
        {
          "name": "DispatchHook",
          "description": "Direct hook dispatcher invoked by C++ engine",
          "returnType": "any?",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Parameters"
            }
          ]
        },
        {
          "name": "GetHookList",
          "description": "Returns array of all registered hook names and metadata",
          "returnType": "table",
          "params": []
        },
        {
          "name": "GetApiSchema",
          "description": "Returns complete machine schema for frontend extension",
          "returnType": "table",
          "params": []
        },
        {
          "name": "ExportApi",
          "description": "Triggers immediate autogeneration of all API definitions and schemas",
          "returnType": "boolean",
          "params": []
        }
      ]
    },
    "Hooks": {
      "description": "Event and lifecycle dispatch bus",
      "parent": "",

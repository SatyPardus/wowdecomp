          "params": [
            {
              "name": "tableName",
              "type": "string",
              "description": "DBC name"
            },
            {
              "name": "id",
              "type": "integer",
              "description": "Record ID"
            },
            {
              "name": "data",
              "type": "table",
              "description": "Record fields"
            }
          ]
        },
        {
          "name": "OverrideRow",
          "description": "Overrides specific fields in an existing DBC record",
          "returnType": "void",
          "params": [
            {
              "name": "tableName",
              "type": "string",
              "description": "DBC name"
            },
            {
              "name": "id",
              "type": "integer",
              "description": "Record ID"
            },
            {
              "name": "overrides",
              "type": "table",
              "description": "Field overrides"
            }
          ]
        },
        {
          "name": "OnRowLookup",

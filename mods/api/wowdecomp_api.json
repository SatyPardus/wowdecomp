          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "callback",
              "type": "fun(...)",
              "description": "Function"
            },
            {
              "name": "priority?",
              "type": "integer",
              "description": "Priority"
            },
            {
              "name": "doc?",
              "type": "string",
              "description": "Doc"
            }
          ]
        },
        {
          "name": "Unregister",
          "description": "Unregisters a callback",
          "returnType": "void",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "callback",
              "type": "fun(...)",
              "description": "Function"
            }
          ]
        },
        {
          "name": "Fire",
          "description": "Fires hook across listeners",
          "returnType": "any?",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            },
            {
              "name": "...",
              "type": "any",
              "description": "Args"
            }
          ]
        },
        {
          "name": "HasListeners",
          "description": "Returns true if any callbacks are registered for hook",
          "returnType": "boolean",
          "params": [
            {
              "name": "hookName",
              "type": "string",
              "description": "Hook name"
            }
          ]
        },
        {
          "name": "GetMetadata",
          "description": "Returns dictionary of hook docstrings",
          "returnType": "table<string, string>",
          "params": []
        },
        {
          "name": "GetHookList",
          "description": "Returns list of all active hook names",
          "returnType": "table<integer, string>",
          "params": []
        }
      ]
    },
    "Net": {
      "description": "Declarative packet serialization and opcode router",
      "parent": "",
      "methods": [
        {
          "name": "DefinePacket",
          "description": "Defines a typed binary packet schema",
          "returnType": "void",
          "params": [
            {
              "name": "name",
              "type": "string",
              "description": "Packet identifier"
            },
            {
              "name": "definition",
              "type": "table",
              "description": "Opcode and schema"
            }
          ]
        },
        {
          "name": "Send",
          "description": "Constructs and transmits a binary packet to server",
          "returnType": "boolean",
          "params": [
            {
              "name": "name",
              "type": "string",
              "description": "Packet identifier"
            },
            {
              "name": "data",
              "type": "table",
              "description": "Payload"
            }
          ]
        },
        {
          "name": "OnCustomPacket",
          "description": "Registers a callback for a specific network opcode",
          "returnType": "void",
          "params": [
            {
              "name": "opcode",
              "type": "integer",
              "description": "Network opcode"
            },
            {
              "name": "handler",
              "type": "fun(reader: any)",
              "description": "Handler"
            }
          ]
        }
      ]
    },
    "DbcEngine": {
      "description": "Virtual DBC table and row injector",
      "parent": "",
      "methods": [
        {
          "name": "GetTable",
          "description": "Retrieves a table handle for a loaded DBC",
          "returnType": "table",
          "params": [
            {
              "name": "tableName",
              "type": "string",
              "description": "DBC name"
